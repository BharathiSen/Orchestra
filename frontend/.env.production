# Committed on purpose. Read by `next build` for every production build
# (Cloudflare Workers Builds, `npm run deploy`), so the hosted demo cannot lose
# its "Try the demo" button again because a build environment forgot a variable.
#
# Nothing here is secret: NEXT_PUBLIC_* values are inlined into the browser
# bundle, and the demo account is the shared one published in the README.
#
# Precedence: real environment variables (e.g. Cloudflare dashboard build vars)
# override this file, and so does .env.local on a local machine.
# Docker builds ignore it (.dockerignore excludes .env.*) and use build args.
NEXT_PUBLIC_API_URL=https://orchestra-l799.onrender.com
NEXT_PUBLIC_SITE_URL=https://orchestra.bharathis-ece2023.workers.dev
NEXT_PUBLIC_DEMO_EMAIL=demo@orchestra.dev
NEXT_PUBLIC_DEMO_PASSWORD=orchestra-demo
