# PostgreSQL
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra
POSTGRES_DB=orchestra
POSTGRES_HOST=postgres
# Port inside the compose network. Leave at 5432.
POSTGRES_PORT=5432
# Host port the dev stack publishes Postgres on, bound to 127.0.0.1. Defaults to
# 15432 so it cannot collide with a Postgres already running on 5432.
POSTGRES_HOST_PORT=15432

# Backend
# development | production
# production turns configuration warnings into boot failures (weak JWT secret,
# well-known database password, missing LLM key) and makes rate limiting fail
# closed when Redis is unreachable rather than serving an unmetered endpoint.
ENVIRONMENT=development

# Used by hosted deployments and by docker-compose.prod.yml.
# The development stack ignores these two on purpose — see DEV_* below.
DATABASE_URL=postgresql+psycopg2://orchestra:orchestra@postgres:5432/orchestra
REDIS_URL=redis://redis:6379/0

# The dev stack defaults to its own postgres and redis containers. Set these
# only if you deliberately want local development pointed somewhere else;
# leaving them blank keeps local work off any hosted database.
# DEV_DATABASE_URL=
# DEV_REDIS_URL=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Comma-separated Host header allow-list. "*" disables the check; set your real
# domain(s) in production to reject Host-header spoofing.
ALLOWED_HOSTS=*
# Largest accepted request body, in bytes (25 MB). Must exceed your largest
# knowledge base upload.
MAX_REQUEST_BYTES=26214400
# Recent turns kept in the Redis short-term buffer before older messages are
# compressed into a summary.
MEMORY_BUFFER_SIZE=10
# Use alternate host ports if 3000/8000 are already taken on your machine
CORS_ORIGINS=http://localhost:13000
BACKEND_PORT=18000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:18000
FRONTEND_PORT=13000
# Public origin of the frontend. Used for canonical URLs and link previews;
# set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:13000

# LLM provider: groq (free testing) | ollama (local free) | gemini (production)
LLM_PROVIDER=groq

# Gemini (production)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Groq (recommended free cloud testing)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# Ollama (fully free local — install from https://ollama.com )
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2

# Per-call provider timeout and retry budget. A full multi-agent turn makes four
# calls in sequence, so keep timeout x (retries + 1) bounded or one slow provider
# can hold a request open for minutes.
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3

# Directory for knowledge base document uploads
UPLOAD_DIR=uploads

# Abuse and cost controls (Redis-backed).
# Three limits because one is not enough: rate stops scripted hammering,
# concurrency stops many simultaneous 30-second pipelines from one account, and
# the token budget is the only limit that maps to actual spend.
RATE_LIMIT_ENABLED=true
CHAT_RATE_LIMIT_PER_MINUTE=10
CHAT_MAX_CONCURRENT_STREAMS=3
CHAT_DAILY_TOKEN_BUDGET=200000
SIGNUP_RATE_LIMIT_PER_HOUR=5

# Shared demo account, created by: cd backend && python scripts/seed_demo.py
# Leave blank to hide every demo affordance in the UI.
# These are frontend-only and are compiled into the public bundle by design —
# only ever point them at a throwaway account. Changing them needs a rebuild,
# not just a restart.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
