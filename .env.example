# PostgreSQL
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra
POSTGRES_DB=orchestra
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg2://orchestra:orchestra@postgres:5432/orchestra
REDIS_URL=redis://redis:6379/0
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
# Day 8 — short-term conversation buffer size in Redis
MEMORY_BUFFER_SIZE=10
# Use alternate host ports if 3000/8000 are already taken on your machine
CORS_ORIGINS=http://localhost:13000
BACKEND_PORT=18000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:18000
FRONTEND_PORT=13000

# LLM provider: groq (free testing) | ollama (local free) | gemini (production)
LLM_PROVIDER=groq

# Gemini (production)
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.0-flash

# Groq (recommended free cloud testing)
# Get a key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_DEFAULT_MODEL=llama-3.1-8b-instant

# Ollama (fully free local — install from https://ollama.com )
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_DEFAULT_MODEL=llama3.2

# Knowledge base uploads (Day 6+)
UPLOAD_DIR=uploads
